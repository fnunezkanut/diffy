{
  "manifest_version": 3,
  "name": "Diffy - Bitbucket PR Review",
  "version": "1.14.0",
  "description": "Adds an Open in IntelliJ icon to Bitbucket pull requests and opens them in a git worktree in a running IntelliJ IDE.",
  "minimum_chrome_version": "116",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "alarms", "scripting"],
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*", "https://bitbucket.org/*"],
  "content_scripts": [
    {
      "matches": ["https://bitbucket.org/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/icon48.png"],
      "matches": ["https://bitbucket.org/*"]
    }
  ]
}
