<idea-plugin>
    <id>com.github.fnunezkanut.bbcloud</id>
    <name>Diffy - Bitbucket PR Review</name>
    <vendor>fnunezkanut</vendor>
    <description><![CDATA[
        <p>Seamless Bitbucket Cloud PR reviews inside your JetBrains IDE.</p>
        <p>Helps you review Bitbucket Cloud pull requests without leaving your JetBrains IDE (and its excellent tooling) with help of <a href="https://github.com/fnunezkanut/diffy/blob/main/docs/worktrees.md">Work Trees</a>, inline comments and much more.</p>
        <ul>
            <li>🔐 <b>Secure sign-in</b>: connects to Bitbucket Cloud with OAuth, and the IDE stores your tokens.</li>
            <li>🪟 <b>Diffy - Bitbucket PR Review tool window</b>: triage pull requests from the bottom tool window strip instead of the browser.</li>
            <li>🌳 <b>PR Work Trees</b>: each PR opens in its own project window backed by a separate git <a href="https://github.com/fnunezkanut/diffy/blob/main/docs/worktrees.md">work tree</a>, so a review never touches your main checkout or other PRs.</li>
            <li>📋 <b>Pull Requests tab</b>: one list of PRs from the current repository, your own PRs across the workspace, and your watched projects, open PRs first. Filter by author, assignee, or project, or start a new PR.</li>
            <li>👀 <b>Watched Projects tab</b>: choose which repositories feed the Pull Requests tab. Search by slug, folder, PR number, or branch, and use the master checkbox to toggle every matching row. The Checkout Project button clones, over SSH, a workspace repository that is not in the Projects Directory yet and watches it.</li>
            <li>🕘 <b>Recent Projects tab</b>: your IDE recent projects and PR Work Tree projects in one list.</li>
            <li>🔖 <b>PR editor tab</b>: each PR opens as a <b><code>&lt;prNum&gt;.pr</code></b> tab with a blue header stripe that shows line-change stats and has buttons to refresh, show file changes, merge, approve, toggle draft, or decline.</li>
            <li>🕐 <b>Activity timeline</b>: commits, approvals, tasks, builds, and file and inline comment threads in time order. Add PR-level comments or reply in any thread.</li>
            <li>🤖 <b>Send this comment to Air</b>: a button on every comment box that copies the file location and the comment into the JetBrains Air chat input, ready to send. Requires the JetBrains Air plugin.</li>
            <li>✨ <b>Explain this PR with AI</b>: a button next to Edit Description on open PRs that starts a new Air chat with a prompt asking the agent to explain the PR with Mermaid diagrams. Press Enter to run it. Requires the JetBrains Air plugin.</li>
            <li>📁 <b>PR Changes tool window</b>: lists every file in the diff. Open it with the stripe's <b>Show pull request file changes</b> button, then pick a file to view it in the editor or in a diff view.</li>
            <li>✏️ <b>Modified File View and Diff View</b>: see existing comments, add line comments from the gutter or context menu, check added and removed line counts, and mark files as reviewed.</li>
            <li>📝 <b>Rendered Markdown diff</b>: changed Markdown files render side by side, so you review documentation the way readers will see it. The <b>Wrap Lines</b> button in the review bar removes horizontal scrolling and remembers your choice.</li>
            <li>🚀 <b>Create Pull Request</b>: set the title, description, source and destination branches, and reviewers (defaults included), choose whether to clean up the remote branch after merge, then open the new PR in a work tree window.</li>
            <li>🔔 <b>Notifications tab</b>: Bitbucket notifications captured by the <a href="https://github.com/fnunezkanut/diffy/tree/main/diffy-chrome-ext">Diffy Chrome extension</a> or <a href="https://github.com/fnunezkanut/diffy/tree/main/diffy-firefox-ext">Firefox extension</a>, newest first, with time, type, pull request, actor, and message.</li>
        </ul>
    ]]></description>

    <change-notes><![CDATA[
        <ul>
            <li>Fixed: the Chrome Web Store extension could not sync, open pull requests, or deliver notifications because the plugin accepted only the development extension ID; the Sync button also reported this as a missing workspace</li>
            <li>Removed: Bitbucket API token sign-in. The plugin now signs in with Bitbucket OAuth only. If you used an API token, open Settings &gt; Tools &gt; Diffy - Bitbucket PR Review and authenticate with Bitbucket oauth login; the old token is deleted when you do</li>
            <li>Added: Notifications tab has a Filter out bots checkbox that hides notifications from bots; the choice is remembered</li>
            <li>Changed: PR diffs in a work tree show the editable, fully navigable work tree file on the right side when the work tree is at or ahead of the pull request source commit (Settings &gt; Tools &gt; Diffy)</li>
            <li>Added: an orange bar under the blue bar marks files with changes that are not in the pull request yet (unpushed commits or uncommitted edits), with Commit… and Push… links</li>
        </ul>
    ]]></change-notes>

    <depends>com.intellij.modules.platform</depends>
    <depends>Git4Idea</depends>
    <depends>org.intellij.plugins.markdown</depends>
    <!-- VCS classes (ChangesUtil, SimpleAsyncChangesBrowser, ComplexPathVirtualFileSystem, dvcs repo) live in this plugin since 2026.3. -->
    <depends>com.intellij.platform.vcs</depends>
    <!-- Optional: the Send to Air button needs the JetBrains Air plugin. The plugin works without it (see ui/air/AirChatBridge.kt). -->
    <depends optional="true" config-file="diffy-air.xml">com.intellij.air</depends>

    <resource-bundle>messages.DiffyBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <applicationService
                serviceImplementation="com.github.fnunezkanut.bbcloud.review.DiffyPullRequestViewedThreads"/>
        <applicationService
                serviceImplementation="com.github.fnunezkanut.bbcloud.git.DiffyWorktreeService"/>
        <applicationService
                serviceImplementation="com.github.fnunezkanut.bbcloud.ui.pullrequest.decline.DiffyPullRequestDeclineCoordinator"/>
        <applicationService
                serviceImplementation="com.github.fnunezkanut.bbcloud.settings.DiffySettings"/>
        <applicationService
                serviceImplementation="com.github.fnunezkanut.bbcloud.review.DiffyKnownUsersState"/>
        <applicationService
                serviceImplementation="com.github.fnunezkanut.bbcloud.cache.DiffyPullRequestCacheState"/>
        <applicationService
                serviceImplementation="com.github.fnunezkanut.bbcloud.cache.DiffyWorkspaceRepositoryCacheState"/>
        <applicationService
                serviceImplementation="com.github.fnunezkanut.bbcloud.external.DiffyNotificationsState"/>
        <applicationService
                serviceInterface="com.github.fnunezkanut.bbcloud.credentials.DiffyCredentialStore"
                serviceImplementation="com.github.fnunezkanut.bbcloud.credentials.PasswordSafeDiffyCredentialStore"/>
        <applicationService
                serviceInterface="com.github.fnunezkanut.bbcloud.auth.DiffyAccessTokenProvider"
                serviceImplementation="com.github.fnunezkanut.bbcloud.auth.DiffyAuthService"/>
        <applicationService
                serviceImplementation="com.github.fnunezkanut.bbcloud.auth.DiffyOAuthLoginService"/>
        <applicationService
                serviceImplementation="com.github.fnunezkanut.bbcloud.external.DiffyBrowserSnapshotStore"/>
        <applicationService
                serviceImplementation="com.github.fnunezkanut.bbcloud.external.DiffyBrowserSnapshotCacheService"/>
        <notificationGroup id="Diffy"
                           displayType="BALLOON"
                           key="notification.group.diffy"/>
        <iconMapper mappingFile="DiffyIconMappings.json"/>
        <toolWindow id="Diffy - Bitbucket PR Review"
                    secondary="true"
                    icon="/icons/prToolWindow.svg"
                    anchor="bottom"
                    factoryClass="com.github.fnunezkanut.bbcloud.toolwindow.DiffyToolWindowFactory"/>
        <toolWindow id="Diffy - PR Changes"
                    anchor="left"
                    doNotActivateOnStart="true"
                    icon="/icons/prChangesToolWindow.svg"
                    factoryClass="com.github.fnunezkanut.bbcloud.ui.pullrequest.changes.WorktreePullRequestChangesToolWindowFactory"/>
        <projectService serviceImplementation="com.github.fnunezkanut.bbcloud.review.DiffyPullRequestReviewState"/>
        <projectService serviceImplementation="com.github.fnunezkanut.bbcloud.review.DiffyPullRequestViewedFiles"/>
        <projectService serviceImplementation="com.github.fnunezkanut.bbcloud.review.DiffyWorktreePullRequestContext"/>
        <projectService serviceImplementation="com.github.fnunezkanut.bbcloud.review.WorktreeTodoBannerViewModel"/>
        <projectService serviceImplementation="com.github.fnunezkanut.bbcloud.review.WorktreePullRequestPageReloader"/>
        <projectService serviceImplementation="com.github.fnunezkanut.bbcloud.git.DiffyPrBranchSyncService"/>
        <postStartupActivity implementation="com.github.fnunezkanut.bbcloud.ui.pullrequest.editor.DiffyPullRequestEditorStartupActivity"/>
        <postStartupActivity implementation="com.github.fnunezkanut.bbcloud.review.DiffyWorktreePullRequestContextStartupActivity"/>
        <postStartupActivity implementation="com.github.fnunezkanut.bbcloud.external.DiffyBrowserSnapshotCacheStartupActivity"/>
        <projectService serviceImplementation="com.github.fnunezkanut.bbcloud.ui.diff.DiffyPullRequestDiffCommentService"/>
        <projectService serviceImplementation="com.github.fnunezkanut.bbcloud.ui.pullrequest.editor.DiffyPullRequestEditorOpener"/>
        <projectService serviceImplementation="com.github.fnunezkanut.bbcloud.ui.pullrequest.create.DiffyNewPullRequestEditorOpener"/>
        <projectService serviceImplementation="com.github.fnunezkanut.bbcloud.ui.pullrequest.help.DiffyWorktreesHelpEditorOpener"/>
        <projectService serviceImplementation="com.github.fnunezkanut.bbcloud.ui.pullrequest.help.DiffyNotificationsHelpEditorOpener"/>
        <projectService serviceImplementation="com.github.fnunezkanut.bbcloud.ui.markdowndiff.DiffyMarkdownDiffEditorOpener"/>
        <projectService serviceImplementation="com.github.fnunezkanut.bbcloud.ui.DiffyToolWindowPanel"/>
        <projectConfigurable
                parentId="tools"
                instance="com.github.fnunezkanut.bbcloud.settings.DiffyToolsConfigurable"
                id="com.github.fnunezkanut.bbcloud.settings.DiffyToolsConfigurable"
                key="configurable.tools.displayName"
                bundle="messages.DiffyBundle"/>
        <virtualFileSystem
                key="diffypr"
                implementationClass="com.github.fnunezkanut.bbcloud.ui.pullrequest.editor.DiffyPullRequestVirtualFileSystem"/>
        <fileEditorProvider
                implementationClass="com.github.fnunezkanut.bbcloud.ui.pullrequest.editor.DiffyPullRequestFileEditorProvider"/>
        <fileEditorProvider
                implementationClass="com.github.fnunezkanut.bbcloud.ui.pullrequest.create.DiffyNewPullRequestFileEditorProvider"/>
        <fileEditorProvider
                implementationClass="com.github.fnunezkanut.bbcloud.ui.pullrequest.help.DiffyWorktreesHelpFileEditorProvider"/>
        <fileEditorProvider
                implementationClass="com.github.fnunezkanut.bbcloud.ui.pullrequest.help.DiffyNotificationsHelpFileEditorProvider"/>
        <fileEditorProvider
                implementationClass="com.github.fnunezkanut.bbcloud.ui.markdowndiff.DiffyMarkdownDiffFileEditorProvider"/>
        <editorTabTitleProvider
                implementationClass="com.github.fnunezkanut.bbcloud.ui.pullrequest.editor.DiffyPullRequestEditorTabTitleProvider"/>
        <fileType name="Diffy - Bitbucket PR Review Overview"
                  implementationClass="com.github.fnunezkanut.bbcloud.ui.pullrequest.editor.DiffyPullRequestFileType"
                  fieldName="INSTANCE"/>
        <fileType name="Bitbucket Cloud New PR"
                  implementationClass="com.github.fnunezkanut.bbcloud.ui.pullrequest.create.DiffyNewPullRequestFileType"
                  fieldName="INSTANCE"/>
        <fileType name="Bitbucket Cloud Work Trees Help"
                  implementationClass="com.github.fnunezkanut.bbcloud.ui.pullrequest.help.DiffyWorktreesHelpFileType"
                  fieldName="INSTANCE"/>
        <fileType name="Bitbucket Cloud Notifications Help"
                  implementationClass="com.github.fnunezkanut.bbcloud.ui.pullrequest.help.DiffyNotificationsHelpFileType"
                  fieldName="INSTANCE"/>
        <fileType name="Bitbucket Cloud Markdown Diff"
                  implementationClass="com.github.fnunezkanut.bbcloud.ui.markdowndiff.DiffyMarkdownDiffFileType"
                  fieldName="INSTANCE"/>
        <diff.DiffExtension
                implementation="com.github.fnunezkanut.bbcloud.ui.pullrequest.editor.PullRequestDiffBarsDiffExtension"/>
        <editorNotificationProvider
                implementation="com.github.fnunezkanut.bbcloud.ui.pullrequest.editor.DiffyPullRequestReviewBarProvider"/>
        <editorNotificationProvider
                implementation="com.github.fnunezkanut.bbcloud.ui.pullrequest.editor.DiffyWorktreePrViewBlueBarEditorNotificationProvider"/>
        <editorNotificationProvider
                implementation="com.github.fnunezkanut.bbcloud.ui.pullrequest.editor.DiffyWorktreeUnpushedChangesEditorNotificationProvider"/>
        <treeStructureProvider
                implementation="com.github.fnunezkanut.bbcloud.ui.pullrequest.projectView.DiffyPullRequestTreeStructureProvider"/>
        <postStartupActivity
                implementation="com.github.fnunezkanut.bbcloud.ui.pullrequest.projectView.DiffyPullRequestProjectViewRefreshStartupActivity"/>
        <httpRequestHandler
                implementation="com.github.fnunezkanut.bbcloud.external.DiffyOpenPullRequestRestService"/>
        <httpRequestHandler
                implementation="com.github.fnunezkanut.bbcloud.external.DiffyBrowserSnapshotRestService"/>
        <httpRequestHandler
                implementation="com.github.fnunezkanut.bbcloud.external.DiffyWorkspaceRestService"/>
    </extensions>

    <actions>
        <action id="Diffy.PullRequest.AddReviewComment"
                class="com.github.fnunezkanut.bbcloud.ui.diff.PullRequestAddReviewCommentAction">
            <add-to-group group-id="EditorGutterPopupMenu" anchor="first"/>
            <add-to-group group-id="EditorPopupMenu" anchor="first"/>
        </action>
        <action id="Diffy.MarkdownDiff.ShowForFile"
                class="com.github.fnunezkanut.bbcloud.ui.markdowndiff.ShowMarkdownDiffAction"
                icon="AllIcons.Actions.Diff">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <add-to-group group-id="EditorTabPopupMenu" anchor="last"/>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
            <add-to-group group-id="ChangesViewPopupMenu" anchor="last"/>
        </action>
        <action id="Diffy.MarkdownDiff.ShowFromDiffViewer"
                class="com.github.fnunezkanut.bbcloud.ui.markdowndiff.ShowMarkdownDiffFromDiffViewerAction"
                icon="AllIcons.Actions.Preview">
            <add-to-group group-id="Diff.ViewerToolbar" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
